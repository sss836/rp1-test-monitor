# TEMPLATE ONLY: install on the upper-computer PC, never on the robot.
RP1_RELAY_PYTHON=/opt/rp1-monitor/.venv/bin/python
RP1_ROBOT_ID=RP1-001
RP1_SOURCE_KIND=ros2
# Independently maintained SSH tunnel over the Ethernet cable:
RP1_COLLECTOR_URL=http://127.0.0.1:18911
RP1_MONITOR_BACKEND=https://monitor.example.internal/monitor
RP1_DEVICE_TOKEN_FILE=/etc/rp1-monitor/device-token.txt
RP1_RELAY_STATE=/var/lib/rp1-monitor-relay/RP1-001
RP1_RELAY_PORT=8892
RP1_RELAY_CACHE_MIB=1024
RP1_RELAY_RESERVE_MIB=256
# RP1_MONITOR_CA_FILE=/etc/rp1-monitor/company-ca.pem
