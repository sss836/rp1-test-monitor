# TEMPLATE ONLY. Replace all machine-specific paths and robot id.
RP1_ROS_SETUP=/opt/ros/humble/setup.bash
RP1_WORKSPACE_SETUP=/home/robot/ros_ws/install/setup.bash
RP1_MONITOR_PYTHON=/opt/rp1-monitor/.venv-agent/bin/python
RP1_ROBOT_ID=RP1-001
RP1_MONITOR_STATE=/var/lib/rp1-monitor
RP1_MONITOR_PORT=8891
RP1_MONITOR_CACHE_MIB=1024
RP1_MONITOR_RESERVE_MIB=256
ROS_DOMAIN_ID=0
# Optional verified robot profile, containing no secrets:
# RP1_MONITOR_PROFILE=/etc/rp1-monitor/profile.json
# Configure RMW_IMPLEMENTATION and DDS profiles only after checking real settings.
# Optional board self-checks; does not install/upgrade RoboPi TUI or motor drivers.
# RP1_ROBOPI_TUI_EXECUTOR=/opt/roboparty/lib/robopi-tui/loader/plugin_executor.py
