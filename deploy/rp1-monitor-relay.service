# TEMPLATE: upper-computer PC only; review paths and maintain the SSH tunnel separately.
[Unit]
Description=RP1 upper-computer receiver and central uploader
After=network.target

[Service]
Type=simple
User=monitor
WorkingDirectory=/opt/rp1-monitor
EnvironmentFile=/etc/rp1-monitor/relay.env
ExecStart=/bin/bash /opt/rp1-monitor/deploy/start-relay.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
