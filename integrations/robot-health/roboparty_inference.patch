+
+// Low-frequency observer reads existing driver caches; never sends a bus command.
+std::vector<RobotInterface::MotorHealthReading> RobotInterface::get_motor_health() {
+    std::unique_lock<std::mutex> lock(motors_mutex_, std::try_to_lock);
+    if (!lock.owns_lock()) return {};
+    std::vector<MotorHealthReading> result;
+    for (size_t i = 0; i < motors_.size() && i < motor2urdf_.size(); ++i) {
+        if (motor2urdf_[i] < 0) continue;
+        result.push_back({"joint_" + std::to_string(motor2urdf_[i]),
+            motors_[i]->get_can_name(), static_cast<uint16_t>(motors_cfg_->motor_id_[i]),
+            motors_[i]->get_health_snapshot()});
+    }
+    return result;
+}
